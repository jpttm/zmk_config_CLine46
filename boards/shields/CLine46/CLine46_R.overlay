#include "CLine46.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/battery_history_request.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse-gesture.h>

&default_transform {
    col-offset = <6>;
};


/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};


&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  //P0.09を指定(CS)

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        //swap-xy;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

// Overrides for the input listener node
&trackball_listener {
    status = "okay";
    input-processors =<&mouse_runtime_input_processor>,
        //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;         //Y軸反転
        //<&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
        <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>;       //X軸反転
        //<&zip_temp_layer 2 1000>;                            //オートマウスレイヤーの選択;


    scroller {
        layers = <3>;
        input-processors =
            // <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
            <&zip_xy_to_scroll_mapper>,                         //スクロールモードに変更
            <&scroll_runtime_input_processor>;                  //速度・軸反転・軸スナップをDYA Studioから設定可能に
    };

    // ============================================================
    // マウスジェスチャー: レイヤー7〜10 をジェスチャー専用レイヤーに割り当て
    //
    // 注意1: process-next を付けていないため、ベースの input-processors は
    //        適用されない。X軸反転はジェスチャー側にも明示的に必要。
    // 注意2: これらのレイヤーにいる間はカーソルを止めたい。
    //        モジュールの suppress-movement は使わない(意図的に外してある)。
    //        あれは ZMK_INPUT_PROC_STOP を返すが、
    //          (a) apply_config() は STOP を受けた時点でチェーンを打ち切るため
    //              後段の zip_xy_scaler に到達しない
    //          (b) input_listener.c はレイヤー上書き経路でその STOP を
    //              握り潰す(process-next 無しなら return 0)
    //        の二重の理由で、結局そのまま HID に流れてカーソルが動いてしまう。
    //        代わりに末尾の <&zip_xy_scaler 0 1> で X/Y を 0 に潰して固定する。
    // 注意3: レイヤーを減らす場合は、下の子ノードと対応する zip_gesture_N、
    //        runtime_macro_defaults の該当エントリをまとめて削除する。
    //
    // 感度は実機比較の結果 4レイヤーとも同一設定に確定した。
    //   stroke-size 100 (縦横とも約4.2mm) / movement-threshold 5
    // 縦横で距離を変える案(横だけ増幅)も試したが、累積残留バグを直した後は
    // 利点が無く、縦の斜めブレ許容量を削るだけだったため対称に戻している。
    // ============================================================
    gesture_layer_7 {
        layers = <7>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転(ベースと合わせる)
            <&zip_gesture_7>,
            <&zip_xy_scaler 0 1>;                               //カーソル固定
    };

    gesture_layer_8 {
        layers = <8>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_gesture_8>,
            <&zip_xy_scaler 0 1>;
    };

    gesture_layer_9 {
        layers = <9>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_gesture_9>,
            <&zip_xy_scaler 0 1>;
    };

    gesture_layer_10 {
        layers = <10>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_gesture_10>,
            <&zip_xy_scaler 0 1>;
    };
};

// ============================================================
// マウスジェスチャー定義
//
//   ノード名 gestureN_M :  N = レイヤー番号 / M = 方向コード
//   M: 1=上 2=下 3=左 4=右
//
//   実行先は Runtime Macro スロット。スロットと名前の対応は下の
//   runtime_macro_defaults で固定している。
//
//     レイヤー7  : slot  0(上)  1(下)  2(左)  3(右)   -> G7-*
//     レイヤー8  : slot  4(上)  5(下)  6(左)  7(右)   -> G8-*
//     レイヤー9  : slot  8(上)  9(下) 10(左) 11(右)   -> G9-*
//     レイヤー10 : slot 12(上) 13(下) 14(左) 15(右)   -> G10-*
//
//   ジェスチャーの個数・長さに上限は無い(フォークした側でトライ木を
//   devicetree から実寸確保するようにしたため)。増やした分だけ、
//   1ストロークあたり20バイト程度ずつ増えるだけ。
//   ただし Runtime Macro のスロットは全16個で頭打ちなので、
//   方向を増やすにはスロットの割り当てを見直す必要がある。
// ============================================================
/ {
    zip_gesture_7: zip_gesture_7 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;          //レイヤー上書きで動作範囲が限定されるため専用の起動キーは不要
        enable-eager-mode;      //パターン確定時に即実行
        gesture-cooldown-ms = <200>;  //発火後の待ち時間(既定500から短縮)
        idle-reset-ms = <400>;        //中途半端な累積を400ms無操作で破棄
        stroke-size = <100>;      //縦横とも約4.2mm
        movement-threshold = <5>; //微小移動を無視(ノイズ除去)

        gesture7_1 { pattern = <GESTURE_UP>;    bindings = <&rmacro 0>; };
        gesture7_2 { pattern = <GESTURE_DOWN>;  bindings = <&rmacro 1>; };
        gesture7_3 { pattern = <GESTURE_LEFT>;  bindings = <&rmacro 2>; };
        gesture7_4 { pattern = <GESTURE_RIGHT>; bindings = <&rmacro 3>; };
    };

    zip_gesture_8: zip_gesture_8 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        gesture-cooldown-ms = <200>;
        idle-reset-ms = <400>;
        stroke-size = <100>;      //縦横とも約4.2mm
        movement-threshold = <5>; //微小移動を無視(ノイズ除去)

        gesture8_1 { pattern = <GESTURE_UP>;    bindings = <&rmacro 4>; };
        gesture8_2 { pattern = <GESTURE_DOWN>;  bindings = <&rmacro 5>; };
        gesture8_3 { pattern = <GESTURE_LEFT>;  bindings = <&rmacro 6>; };
        gesture8_4 { pattern = <GESTURE_RIGHT>; bindings = <&rmacro 7>; };
    };

    zip_gesture_9: zip_gesture_9 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        gesture-cooldown-ms = <200>;
        idle-reset-ms = <400>;
        stroke-size = <100>;      //縦横とも約4.2mm
        movement-threshold = <5>; //微小移動を無視(ノイズ除去)

        gesture9_1 { pattern = <GESTURE_UP>;    bindings = <&rmacro 8>; };
        gesture9_2 { pattern = <GESTURE_DOWN>;  bindings = <&rmacro 9>; };
        gesture9_3 { pattern = <GESTURE_LEFT>;  bindings = <&rmacro 10>; };
        gesture9_4 { pattern = <GESTURE_RIGHT>; bindings = <&rmacro 11>; };
    };

    zip_gesture_10: zip_gesture_10 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        gesture-cooldown-ms = <200>;
        idle-reset-ms = <400>;
        stroke-size = <100>;      //縦横とも約4.2mm
        movement-threshold = <5>; //微小移動を無視(ノイズ除去)

        gesture10_1 { pattern = <GESTURE_UP>;    bindings = <&rmacro 12>; };
        gesture10_2 { pattern = <GESTURE_DOWN>;  bindings = <&rmacro 13>; };
        gesture10_3 { pattern = <GESTURE_LEFT>;  bindings = <&rmacro 14>; };
        gesture10_4 { pattern = <GESTURE_RIGHT>; bindings = <&rmacro 15>; };
    };

    // ============================================================
    // ジェスチャー用 Runtime Macro の初期値
    //
    // 宣言順にスロット 0〜15 へ確定的に割り当てられる。
    // DYA Studio のマクロ一覧には下記の名前で並ぶので、
    // 番号ではなく名前を見て編集すればよい。
    // 内容は DYA Studio から自由に書き換え可能(再ビルド不要)。
    // ============================================================
    runtime_macro_defaults {
        // --- レイヤー7: ブラウザのタブ操作 ---
        g7_up   { compatible = "cormoran,runtime-macro-default"; macro-name = "G7-Up"; bindings = <&kp LC(T)>; };  //新しいタブ
        g7_down { compatible = "cormoran,runtime-macro-default"; macro-name = "G7-Down"; bindings = <&kp LC(W)>; };  //タブを閉じる
        g7_left { compatible = "cormoran,runtime-macro-default"; macro-name = "G7-Left"; bindings = <&kp LC(LS(TAB))>; };  //前のタブ
        g7_right{ compatible = "cormoran,runtime-macro-default"; macro-name = "G7-Right"; bindings = <&kp LC(TAB)>; };  //次のタブ

        // --- レイヤー8: 仮想デスクトップ / ウィンドウ ---
        g8_up   { compatible = "cormoran,runtime-macro-default"; macro-name = "G8-Up"; bindings = <&kp LG(TAB)>; };  //タスクビュー
        g8_down { compatible = "cormoran,runtime-macro-default"; macro-name = "G8-Down"; bindings = <&kp LG(D)>; };  //デスクトップ表示
        g8_left { compatible = "cormoran,runtime-macro-default"; macro-name = "G8-Left"; bindings = <&kp LC(LG(LEFT))>; };  //仮想デスクトップ左
        g8_right{ compatible = "cormoran,runtime-macro-default"; macro-name = "G8-Right"; bindings = <&kp LC(LG(RIGHT))>; };  //仮想デスクトップ右

        // --- レイヤー9: ページ内ナビゲーション ---
        g9_up   { compatible = "cormoran,runtime-macro-default"; macro-name = "G9-Up"; bindings = <&kp LC(HOME)>; };  //先頭へ
        g9_down { compatible = "cormoran,runtime-macro-default"; macro-name = "G9-Down"; bindings = <&kp LC(END)>; };  //末尾へ
        g9_left { compatible = "cormoran,runtime-macro-default"; macro-name = "G9-Left"; bindings = <&kp LA(LEFT)>; };  //戻る
        g9_right{ compatible = "cormoran,runtime-macro-default"; macro-name = "G9-Right"; bindings = <&kp LA(RIGHT)>; };  //進む

        // --- レイヤー10: 編集 ---
        g10_up   { compatible = "cormoran,runtime-macro-default"; macro-name = "G10-Up"; bindings = <&kp LC(Z)>; };  //元に戻す
        g10_down { compatible = "cormoran,runtime-macro-default"; macro-name = "G10-Down"; bindings = <&kp LC(Y)>; };  //やり直し
        g10_left { compatible = "cormoran,runtime-macro-default"; macro-name = "G10-Left"; bindings = <&kp LC(C)>; };  //コピー
        g10_right{ compatible = "cormoran,runtime-macro-default"; macro-name = "G10-Right"; bindings = <&kp LC(V)>; };  //貼り付け
    };
};

// スクロール用のランタイム入力プロセッサ。
//
// 以前は zip_scroll_transform / zip_scroll_scaler / zip_xy_transform を
// 静的に並べていたが、それらは再ビルドしないと変更できなかった。
// scroll_runtime_input_processor に置き換えると、同じ調整が DYA Studio の
// 「トラックボール設定」から行えるようになり、さらに軸スナップ
// (移動を縦横どちらかに固定する機能。表計算ソフトで有用) も使えるようになる。
//
// 注意: このノードは runtime-input-processor.dtsi 内で /omit-if-no-ref/ 指定
// されているため、ここで参照して初めて firmware に組み込まれる。参照が無いと
// DYA Studio のプロセッサ一覧にも現れない。
//
// 下の値は従来の静的な設定と同じ体感になるよう合わせた初期値。
// 一度 DYA Studio で変更すると、そちらが保存されて以後優先される。
&scroll_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <8>;    //旧 <&zip_scroll_scaler 1 8> 相当
    x-invert;               //旧 <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT> 相当
    y-invert;               //旧 <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT> 相当(変換前のY反転と等価)
};
