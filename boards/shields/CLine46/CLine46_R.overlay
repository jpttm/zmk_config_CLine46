#include "CLine46.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/battery_history_request.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse-gesture.h>

&default_transform {
    col-offset = <6>;
};


/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};


&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  //P0.09を指定(CS)

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        //swap-xy;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

// Overrides for the input listener node
&trackball_listener {
    status = "okay";
    input-processors =<&mouse_runtime_input_processor>,
        //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;         //Y軸反転
        //<&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
        <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>;       //X軸反転
        //<&zip_temp_layer 2 1000>;                            //オートマウスレイヤーの選択;


    scroller {
        layers = <3>;
        input-processors = 
            // <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
            // <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,       //Y軸反転
            <&zip_xy_to_scroll_mapper>,                         //スクロールモードに変更
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,   //スクロールのX軸反転
            //<&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,   //スクロールのY軸反転
            <&zip_scroll_scaler 1 8>;                           //スクロール量を1/8倍
    };

    // マウスジェスチャー: レイヤーごとに1インスタンス
    // 注意: process-next を付けていないため、ベースの input-processors は適用されない。
    //       X軸反転はジェスチャー側のチェーンで明示的に適用する必要がある。
    gesture_layer_4 {
        layers = <4>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転(ベースと合わせる)
            <&zip_gesture_4>;
    };

    gesture_layer_5 {
        layers = <5>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_gesture_5>;
    };

    gesture_layer_6 {
        layers = <6>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_gesture_6>;
    };
};

// ============================================================
// マウスジェスチャー定義
//   ノード名 gestureNM :  N = レイヤー番号 / M = 方向コード
//   M: 1=上 2=下 3=左 4=右 5=下左 6=下右 7=下上 8=左右
// ============================================================
/ {
    zip_gesture_4: zip_gesture_4 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;          // レイヤーが有効な間だけこのプロセッサが動くため、専用キーは不要
        suppress-movement;      // ジェスチャー中はカーソルを動かさない
        enable-eager-mode;      // パターン確定時に即実行
        stroke-size = <200>;

        gesture41 { pattern = <GESTURE_UP>;                   bindings = <&kp LG(TAB)>; };            //タスクビュー
        gesture42 { pattern = <GESTURE_DOWN>;                 bindings = <&kp LG(D)>; };              //デスクトップ表示
        gesture43 { pattern = <GESTURE_LEFT>;                 bindings = <&kp LC(LG(LEFT))>; };       //仮想デスクトップ左
        gesture44 { pattern = <GESTURE_RIGHT>;                bindings = <&kp LC(LG(RIGHT))>; };      //仮想デスクトップ右
        gesture45 { pattern = <GESTURE_DOWN GESTURE_LEFT>;    bindings = <&kp LC(LS(TAB))>; };        //前のタブ
        gesture46 { pattern = <GESTURE_DOWN GESTURE_RIGHT>;   bindings = <&kp LC(TAB)>; };            //次のタブ
        gesture47 { pattern = <GESTURE_DOWN GESTURE_UP>;      bindings = <&kp LC(W)>; };              //タブを閉じる
        gesture48 { pattern = <GESTURE_LEFT GESTURE_RIGHT>;   bindings = <&kp LC(LS(T))>; };          //閉じたタブを復元
    };

    // レイヤー5/6 は RAM 実測用のインスタンス (4方向のみ)
    zip_gesture_5: zip_gesture_5 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        suppress-movement;
        enable-eager-mode;
        stroke-size = <200>;

        gesture51 { pattern = <GESTURE_UP>;    bindings = <&kp LC(HOME)>; };
        gesture52 { pattern = <GESTURE_DOWN>;  bindings = <&kp LC(END)>; };
        gesture53 { pattern = <GESTURE_LEFT>;  bindings = <&kp LA(LEFT)>; };     //戻る
        gesture54 { pattern = <GESTURE_RIGHT>; bindings = <&kp LA(RIGHT)>; };    //進む
    };

    zip_gesture_6: zip_gesture_6 {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        suppress-movement;
        enable-eager-mode;
        stroke-size = <200>;

        gesture61 { pattern = <GESTURE_UP>;    bindings = <&kp UP>; };
        gesture62 { pattern = <GESTURE_DOWN>;  bindings = <&kp DOWN>; };
        gesture63 { pattern = <GESTURE_LEFT>;  bindings = <&kp LEFT>; };
        gesture64 { pattern = <GESTURE_RIGHT>; bindings = <&kp RIGHT>; };
    };
};